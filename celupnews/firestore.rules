rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function newsAdmin() { return signedIn() && request.auth.uid == '17MUSIoI22ZZUGed7gw6lIMDJuo2'; }
    function publicText(value, max) { return value is string && value.size() <= max; }
    match /admins/{uid} {
      allow get: if newsAdmin() && uid == request.auth.uid;
      allow list: if false;
      allow create, update: if newsAdmin() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['displayName','photoUrl','bio','updatedAt'])
        && publicText(request.resource.data.displayName, 100)
        && publicText(request.resource.data.photoUrl, 1000)
        && publicText(request.resource.data.bio, 1000);
      allow delete: if false;
    }
    match /articles/{articleNumber} {
      allow get, list: if newsAdmin() || resource.data.status == 'published';
      allow create: if newsAdmin()
        && request.resource.data.articleNumber == articleNumber
        && request.resource.data.status in ['draft','scheduled','published','archived']
        && publicText(request.resource.data.title, 180)
        && publicText(request.resource.data.slug, 100)
        && publicText(request.resource.data.description, 300)
        && request.resource.data.content is string && request.resource.data.content.size() <= 200000
        && request.resource.data.categoryId is string && request.resource.data.authorId is string
        && request.resource.data.viewCount is number && request.resource.data.isFeatured is bool;
      allow update: if newsAdmin()
        && request.resource.data.articleNumber == resource.data.articleNumber
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.status != 'published' || request.resource.data.publishedAt == resource.data.publishedAt || request.resource.data.status == 'archived')
        && request.resource.data.status in ['draft','scheduled','published','archived']
        && publicText(request.resource.data.title, 180)
        && publicText(request.resource.data.slug, 100)
        && publicText(request.resource.data.description, 300)
        && request.resource.data.content is string && request.resource.data.content.size() <= 200000
        && request.resource.data.isFeatured is bool && request.resource.data.viewCount is number;
      allow delete: if newsAdmin();
    }
    match /authors/{authorId} {
      allow get, list: if newsAdmin() || resource.data.isActive == true;
      allow create, update: if newsAdmin()
        && request.resource.data.keys().hasOnly(['name','slug','photoUrl','photoPublicId','description','isActive','createdAt','updatedAt'])
        && publicText(request.resource.data.name, 120) && publicText(request.resource.data.slug, 120)
        && publicText(request.resource.data.photoUrl, 1000) && publicText(request.resource.data.description, 1000)
        && request.resource.data.isActive is bool;
      allow delete: if newsAdmin();
    }
    match /categories/{categoryId} {
      allow get, list: if newsAdmin() || resource.data.isActive == true;
      allow create, update: if newsAdmin() && publicText(request.resource.data.name, 80)
        && publicText(request.resource.data.slug, 100) && request.resource.data.isActive is bool;
      allow delete: if newsAdmin();
    }
    match /tags/{tagId} {
      allow read: if true;
      allow write: if newsAdmin() && publicText(request.resource.data.name, 80) && publicText(request.resource.data.slug, 100);
    }
    match /comments/{commentId} {
      allow get, list: if newsAdmin() || resource.data.status == 'approved';
      // Public submissions go through the rate-limited Vercel endpoint; Admin SDK writes pending only.
      allow create: if false;
      allow update: if newsAdmin()
        && request.resource.data.keys().hasOnly(['articleId','name','message','status','createdAt'])
        && request.resource.data.articleId == resource.data.articleId
        && request.resource.data.name == resource.data.name
        && request.resource.data.message == resource.data.message
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['pending','approved','rejected','spam'];
      allow delete: if newsAdmin();
    }
    match /media/{mediaId} {
      allow read, write: if newsAdmin();
    }
    match /site_settings/{settingId} {
      allow get: if newsAdmin() || settingId == 'seo';
      allow list: if newsAdmin();
      allow create, update: if newsAdmin();
      allow delete: if newsAdmin();
    }
    match /activity_logs/{logId} {
      allow get, list: if newsAdmin();
      allow create: if newsAdmin()
        && request.resource.data.adminUid == request.auth.uid
        && publicText(request.resource.data.action, 100)
        && publicText(request.resource.data.detail, 500);
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
